__pycache__/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
runs/
dist/
node_modules/

# local state / secrets — never commit
.env
dashboard/.dashboard-token
workspaces.json
dashboard/workspaces.json
# operational artifacts written into the workspace at runtime — never commit
# (matters when the factory's own repo is a work target: agents/checkpoints must
# not stage these)
.supervisor-session
.judge-*.png
.preview-shot.png
# self-edit workspace: when Warden targets its own repo, its isolated workspace
# (backlog, runs, config) lives here — operational state, never committed
.factory/

# internal working docs — kept locally, not shared in the repo
DASHBOARD_GAPS.md
DASHBOARD_UX_PLAN.md

# operator-local collaborative surfaces (Architecture notes, sketch board) —
# per-workspace state written by the dashboard, not part of the shared repo
architecture.md
board.json

# Nexa-managed agent rules — mirrored into the repo by the Nexa app, kept local
# (their content is Nexa's, not part of this project); ignoring them also keeps
# the working tree clean so runs targeting this repo aren't blocked at preflight
AGENTS.md
CLAUDE.md
