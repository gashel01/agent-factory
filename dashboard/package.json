{
  "name": "agent-factory-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Live dashboard for agent-factory runs — tails events.jsonl over SSE. Zero runtime dependencies.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js && esbuild src/client.ts --bundle --format=iife --outfile=dist/client.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
